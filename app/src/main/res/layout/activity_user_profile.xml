<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moli_fondo"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <!-- ══ HEADER BANNER ══════════════════════════════════ -->
        <View
            android:id="@+id/viewProfileHeader"
            android:layout_width="0dp"
            android:layout_height="210dp"
            android:background="@drawable/bg_profile_header"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón regresar -->
        <ImageButton
            android:id="@+id/btnBackFromProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mex_back"
            android:tint="@color/white"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Regresar"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título en el header -->
        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="MI PERFIL CHEF"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="@id/btnBackFromProfile"
            app:layout_constraintBottom_toBottomOf="@id/btnBackFromProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtítulo decorativo en el header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu cocina, tu identidad"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvProfileTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ══ FOTO DE PERFIL (centrada sobre el borde del header) ══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfilePhoto"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardCornerRadius="68dp"
            app:cardBackgroundColor="@color/moli_fondo"
            app:cardElevation="10dp"
            app:strokeColor="@color/white"
            app:strokeWidth="4dp"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintTop_toBottomOf="@id/viewProfileHeader"
            app:layout_constraintBottom_toBottomOf="@id/viewProfileHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivUserPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_mex_profile"
                android:tint="@color/moli_terracota"
                android:padding="16dp"
                app:shapeAppearanceOverlay="@style/CircleImage" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Botón editar foto (pequeño círculo en esquina inferior derecha) -->
        <ImageView
            android:id="@+id/ivEditPhoto"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_terracota"
            android:src="@drawable/ic_mex_add"
            android:tint="@color/white"
            android:padding="7dp"
            android:elevation="6dp"
            app:layout_constraintEnd_toEndOf="@id/cardProfilePhoto"
            app:layout_constraintBottom_toBottomOf="@id/cardProfilePhoto"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="3dp" />

        <!-- ══ NOMBRE Y ETIQUETA ══════════════════════════════ -->
        <TextView
            android:id="@+id/tvDisplayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tu nombre"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardProfilePhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvChefLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chef · Moli"
            android:textColor="@color/gray_dark"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvDisplayName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ══ TARJETAS DE ESTADÍSTICAS ════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvChefLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Stat: Total recetas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_recipes"
                        app:tint="@color/moli_terracota"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/tvStatTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textColor="@color/moli_terracota"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recetas"
                        android:textColor="@color/gray_dark"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat: Recetas creadas por el usuario -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_mex_add"
                        app:tint="@color/moli_verde"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/tvStatCreadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textColor="@color/moli_verde"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Creadas"
                        android:textColor="@color/gray_dark"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stat: Tiempo cocinado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_timer"
                        app:tint="@color/moli_naranja"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/tvStatTiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textColor="@color/moli_naranja"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min cocin."
                        android:textColor="@color/gray_dark"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ══ TARJETA DE EDICIÓN ══════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEditInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/layoutStats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp">

                <!-- Encabezado de la sección -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@color/moli_terracota"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información personal"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Campo nombre -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUserName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tu nombre de Chef"
                    app:startIconDrawable="@drawable/ic_mex_profile"
                    app:startIconTint="@color/moli_terracota"
                    app:boxStrokeColor="@color/moli_terracota"
                    app:hintTextColor="@color/moli_terracota">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/black"
                        android:imeOptions="actionDone" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ══ BOTONES ═════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="GUARDAR CAMBIOS"
            android:backgroundTint="@color/moli_terracota"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:letterSpacing="0.08"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_mex_profile"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:layout_constraintTop_toBottomOf="@id/cardEditInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:text="Cerrar sesión"
            android:textColor="@color/gray_dark"
            android:textSize="14sp"
            app:strokeColor="@color/gray_light"
            app:cornerRadius="26dp"
            app:layout_constraintTop_toBottomOf="@id/btnSaveProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
