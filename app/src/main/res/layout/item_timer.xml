<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/moli_terracota"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header bar -->
        <LinearLayout
            android:id="@+id/layoutTimerHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/moli_terracota"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_mex_timer"
                android:tint="@color/white"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvTimerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Temporizador 1"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTimerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnDeleteTimer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/white"
                android:padding="6dp"
                android:contentDescription="Eliminar temporizador" />

        </LinearLayout>

        <!-- Circular progress + time -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:indicatorSize="148dp"
                app:trackThickness="10dp"
                app:indicatorColor="@color/moli_terracota"
                app:trackColor="@color/gray_light"
                android:progress="100"
                android:indeterminate="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTimeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:00"
                    android:textColor="@color/moli_terracota"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </FrameLayout>

        <!-- Time input (shown when idle) -->
        <LinearLayout
            android:id="@+id/layoutTimePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:hint="Min"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTimerMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="5"
                    android:gravity="center"
                    android:textSize="20sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/moli_terracota"
                android:layout_marginHorizontal="8dp"
                android:gravity="center" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:hint="Seg"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTimerSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="00"
                    android:gravity="center"
                    android:textSize="20sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartPause"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="48dp"
                android:text="INICIAR"
                android:backgroundTint="@color/moli_terracota"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                app:cornerRadius="24dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetTimer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="RESET"
                android:textColor="@color/moli_terracota"
                app:strokeColor="@color/moli_terracota"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
