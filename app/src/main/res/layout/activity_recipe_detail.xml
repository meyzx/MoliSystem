<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moli_fondo">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/btnBackToMain"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="16dp"
        android:padding="10dp"
        android:background="@color/moli_maiz"
        android:src="@android:drawable/ic_menu_revert"
        app:shapeAppearanceOverlay="@style/RoundedBottomCorners"
        android:elevation="8dp"
        android:translationZ="10dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/RoundedBottomCorners">

                <ImageView
                    android:id="@+id/ivRecipeDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvRecipeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enchiladas Verdes"
                    android:textColor="@color/moli_terracota"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartCooking"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:text="INICIAR MODO COCINA"
                    android:backgroundTint="@color/moli_verde"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_media_play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INGREDIENTES"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/moli_verde"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvIngredientsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• 12 tortillas de maíz\n• 500g de pechuga de pollo\n• 1/2 kg de tomate verde\n• 2 chiles serranos\n• Cilantro y cebolla"
                    android:lineSpacingExtra="6dp"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREPARACIÓN"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/moli_verde"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Cuece el pollo con cebolla y sal.\n2. Licúa los tomates cocidos con el chile y cilantro.\n3. Fríe ligeramente las tortillas, rellena con pollo y baña con la salsa caliente."
                    android:lineSpacingExtra="6dp"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:backgroundTint="@color/moli_maiz"
        app:srcCompat="@android:drawable/ic_menu_recent_history"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>